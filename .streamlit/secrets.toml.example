# Plantilla de secretos — copia este archivo a .streamlit/secrets.toml
# (ese archivo SI esta en .gitignore, este .example NO, para documentar
# que variables espera la plataforma sin exponer valores reales).
#
# Nada de lo que hay aqui es requerido para correr la plataforma hoy: todos
# los modulos actuales (incluido el Asistente de Riesgos) funcionan sin
# ninguna API key. Esto queda preparado para cuando se conecte un LLM real
# (ver services/assistant_engine.py::ProveedorLLM).

# [llm]
# provider = "openai"          # "openai" | "anthropic" | "google"
# api_key = "sk-..."
